{
  "name": "@openreachtech/eslint-rules-default-jest",
  "version": "2.0.1",
  "description": "A showcasing package all the Jest plugin rules of ESLint.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "rules/",
    "types/"
  ],
  "types": "types/index.d.ts",
  "scripts": {
    "audit:actions": "node node_modules/@openreachtech/mentsu-github-actions-inspector/scripts/audit-action-version.js",
    "audit:npm": "node node_modules/@openreachtech/mentsu-npm-audit-gate/scripts/npm-audit-gate.js scripts/stopgap-audit/IGNORED_ADVISORIES.js",
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"; jest --maxWorkers=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreachtech/eslint-rules-default-jest.git"
  },
  "keywords": [
    "ESLint"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/openreachtech/eslint-rules-default-jest/issues"
  },
  "homepage": "https://github.com/openreachtech/eslint-rules-default-jest#readme",
  "dependencies": {
    "eslint-plugin-jest": "^29.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openreachtech/mentsu-github-actions-inspector": "^0.1.0",
    "@openreachtech/mentsu-npm-audit-gate": "^0.1.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-openreachtech": "^1.0.1",
    "jest": "^30.4.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
