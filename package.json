{
  "name": "@openreachtech/eslint-rules-default-jest",
  "version": "1.0.3",
  "description": "A showcasing package all the Jest plugin rules of ESLint.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "rules/",
    "types/"
  ],
  "types": "types/index.d.ts",
  "scripts": {
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"; jest --maxWorkers=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreachtech/eslint-rules-default-jest.git"
  },
  "keywords": [
    "ESLint"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/openreachtech/eslint-rules-default-jest/issues"
  },
  "homepage": "https://github.com/openreachtech/eslint-rules-default-jest#readme",
  "dependencies": {
    "eslint-plugin-jest": "^29.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-openreachtech": "^1.0.1",
    "jest": "^30.4.2"
  },
  "overrides": {
    "flatted": "^3.4.4",
    "picomatch@2": "^2.3.2"
  },
  "allowScripts": {
    "fsevents": false,
    "unrs-resolver": false
  }
}
